<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PersonalStats</AssemblyName>
    <RootNamespace>PersonalStats</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/$(Configuration)/Mods/$(AssemblyName)</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Vintage Story install location. Override with the VINTAGE_STORY env var if it lives elsewhere. -->
  <PropertyGroup>
    <VSPath Condition="'$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VSPath>
    <VSPath Condition="'$(VSPath)' == '' and Exists('/Applications/Vintage Story.app')">/Applications/Vintage Story.app</VSPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VSPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VSPath)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VSPath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VSPath)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Assemble a ready-to-copy mod folder next to the DLL: modinfo.json + assets. -->
  <Target Name="CopyModFiles" AfterTargets="Build">
    <ItemGroup>
      <ModFiles Include="modinfo.json" />
      <AssetFiles Include="assets/**/*.*" Condition="Exists('assets')" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFolder="$(OutDir)assets/%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('assets')" />
  </Target>

</Project>
